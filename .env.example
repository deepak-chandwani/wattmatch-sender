# From Google Cloud Console > APIs & Services > Credentials (OAuth client ID, "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public address of the site, no trailing slash. The redirect URI added in Google must be
#   <BASE_URL>/auth/callback
BASE_URL=http://localhost:3000

# Random secrets. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
TOKEN_KEY=

# Who may sign in. Use one or both. Leave both empty to allow anyone with a Google account.
# Comma-separated, lower case.
ALLOWED_EMAILS=
ALLOWED_DOMAIN=

# Optional
PORT=3000
DAILY_LIMIT=400
SEND_DELAY_SECONDS=20
# Where data is stored. Pick ONE:
# (a) Free cloud database (recommended for free hosting): create a database at turso.tech, then fill both
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# (b) Local file (your own computer, or a server with a disk)
DB_PATH=./data/sender.db
